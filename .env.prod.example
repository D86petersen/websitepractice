# CCNA Platform - Production Deployment Configuration
# This file contains all environment variables needed for production deployment

# Docker Compose will load this file automatically
# Copy to .env.prod and fill in your actual values

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=ccna_prod
POSTGRES_USER=ccna_user
POSTGRES_PASSWORD=change-this-to-a-secure-password-min-32-chars
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# Backend Configuration
# ============================================================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_EXPIRATION=7d

# Database connection for backend
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Configuration
REDIS_URL=redis://redis:6379

# Frontend URL (for CORS)
FRONTEND_URL=https://ccna.example.com

# Optional: Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# Frontend Configuration
# ============================================================================
NEXT_PUBLIC_API_URL=https://api.ccna.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://ccna.example.com

# Optional: Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================================================
# SSL/TLS Certificates (for Nginx)
# Place certificate files in ./certs/ directory:
# - certificate.crt (your SSL certificate)
# - private.key (your private key)
# ============================================================================
# SSL_CERT_PATH=/etc/nginx/certs/certificate.crt
# SSL_KEY_PATH=/etc/nginx/certs/private.key

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM UTC
