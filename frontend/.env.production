# CCNA Platform - Frontend Production Environment
# Copy this to .env.production.local (Next.js convention)

# API Configuration
NEXT_PUBLIC_API_URL="https://api.ccna.example.com/api/v1"

# Application
NEXT_PUBLIC_APP_URL="https://ccna.example.com"

# Analytics (optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ADMIN_PANEL="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
