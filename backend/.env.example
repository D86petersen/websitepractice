# Backend Environment Variables (.env.example)
# Copy to .env and fill in actual values

# Database
DATABASE_URL="postgresql://ccna_user:ccna_password@localhost:5432/ccna_exam"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long-for-hs256"
JWT_EXPIRY="7d"

# Server
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# RateLimit (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GENERAL=60

# Logging
LOG_LEVEL="debug"

# Exam Configuration
PASS_SCORE_PERCENT=70
SCALED_SCORE_MIN=300
SCALED_SCORE_MAX=1000
PASSING_SCALED_SCORE=825
