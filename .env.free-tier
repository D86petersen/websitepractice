# Free Tier Optimized Configuration
# Use this for Railway, Fly.io, Render, or Oracle free tier
# Optimizations: Less memory, simpler setup, minimal resources

NODE_ENV=production
PORT=3001
LOG_LEVEL=warn

# Database (will be provided by platform)
# Railway/Fly.io provide this automatically
# Keep default connection handling
DATABASE_CONNECTION_POOLING=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5

# JWT
JWT_SECRET=free-tier-secret-key-change-in-production-for-security-12345
JWT_EXPIRATION=7d

# Frontend URL (will be provided by platform)
FRONTEND_URL=http://localhost:3000

# Redis (optional - disable for free tier)
REDIS_ENABLED=false

# Logging (reduced for free tier resources)
LOG_FORMAT=json
LOG_LEVEL=info

# Performance Optimization
NODE_OPTIONS=--max-old-space-size=256

# Free Tier Settings
FREE_TIER_MODE=true
SLOW_DOWN_FOR_DEMO_EXAMS=false
